FRIDAY_NAME=FRIDAY
DATA_DIR=data
DEFAULT_MODEL=qwen2.5:0.5b

# Research keeps normal chat fast and uses a stronger specialist separately.
# Change RESEARCH_MODEL to qwen3:14b on machines with roughly 24-32 GB available.
RESEARCH_MODEL=qwen3:8b
RESEARCH_EMBEDDING_MODEL=bge-m3
RESEARCH_NUM_PREDICT=4096
# 8192 is safe for Qwen3 8B with an 8 GB Docker memory allocation. Increase
# only when the Ollama runtime has additional RAM available.
RESEARCH_NUM_CTX=8192
RESEARCH_TIMEOUT_SECONDS=1800
RESEARCH_KEEP_ALIVE=30m
RESEARCH_POLL_SECONDS=2
RESEARCH_ANALYSIS_LIMIT=120
RESEARCH_DIR=data/Research

# Self-hosted discovery and knowledge index services from docker-compose.yml.
SEARXNG_URL=http://searxng:8080
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=friday_research

# Optional free academic API keys improve reliability and allowance.
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# CROSSREF_MAILTO=you@example.com

# On macOS, keep Ollama native so Apple Metal accelerates the 8B specialist.
# Docker containers reach the native service through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Shared Ollama runtime settings for terminal chat and voice.
OLLAMA_NUM_PREDICT=128
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=5m
# Leave unset to let Ollama choose an appropriate thread count.
# OLLAMA_NUM_THREAD=4

# Root available to the deterministic execution service. Relative paths are
# resolved from the FRIDAY process working directory.
EXECUTION_WORKSPACE=.

# Dedicated Qwen workflow planning budget (the same default model, more JSON).
HARNESS_NUM_PREDICT=2048
HARNESS_NUM_CTX=8192

# LiveKit local server
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=friday
FRIDAY_API_BASE_URL=http://friday:8080

# Durable reminder worker
REMINDER_POLL_SECONDS=2
REMINDER_BATCH_SIZE=20
REMINDER_MAX_ATTEMPTS=3
REMINDER_RETRY_SECONDS=30
REMINDER_CLAIM_TIMEOUT_SECONDS=120

# Ollama local voice-agent LLM.
# Use http://ollama:11434/v1 when running from Docker Compose.
# Use http://localhost:11434/v1 when running the agent directly on your Mac.
OLLAMA_VOICE_MODEL=qwen2.5:0.5b
OLLAMA_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_VOICE_NUM_PREDICT=32
OLLAMA_PREWARM_TIMEOUT=60
OLLAMA_VOICE_TIMEOUT=25
OLLAMA_VOICE_TEMPERATURE=0.2

# Faster Whisper local STT
# On Apple Silicon, use CPU because CTranslate2 does not support MPS.
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1
WHISPER_LOAD_TIMEOUT=120
WHISPER_RECOGNIZE_TIMEOUT=20

# Voice activity detection. Raise activation/min speech if the mic is too sensitive.
VAD_ACTIVATION_THRESHOLD=0.65
VAD_DEACTIVATION_THRESHOLD=0.45
VAD_MIN_SPEECH_DURATION=0.25
VAD_MIN_SILENCE_DURATION=0.35
VAD_PREFIX_PADDING_DURATION=0.25
VOICE_MIN_ENDPOINTING_DELAY=0.3
VOICE_MAX_ENDPOINTING_DELAY=1.5

# Voice output provider: kokoro, piper, or voicebox
TTS_PROVIDER=kokoro
# Piper settings, used when TTS_PROVIDER=piper.
PIPER_MODEL=models/piper/en_US-ryan-high.onnx
PIPER_VOLUME=1.0

# Selected local output voice (same engine and preset as the auditions).
KOKORO_VOICE=af_heart
KOKORO_MODEL_DIR=models/kokoro-onnx
KOKORO_NUM_THREADS=4

# Optional output-only Voicebox backend, running natively on the host.
# Set TTS_PROVIDER=voicebox after choosing a voice and downloading Kokoro there.
VOICEBOX_BASE_URL=http://host.docker.internal:17493
VOICEBOX_VOICE=af_heart
VOICEBOX_TIMEOUT=60
